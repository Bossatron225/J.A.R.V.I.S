.DS_Store
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
.venv-*/
.pytest_cache/
.mypy_cache/
.coverage
*.log

# Runtime state, not source — rewritten constantly by the running app, which
# made every auto-commit dirty and buried real changes in the diff.
.jarvis.lock
memory/usage_log.jsonl
memory/visitor_watch_state.json

# Third-party personal data captured by the Nanny-cam protocol. These are NOT
# the user's own synced memory (long_term.json etc. stay tracked on purpose):
# visitor_clusters.json holds face EMBEDDINGS — biometric identifiers — and
# visitor_snapshots/ holds photographs of people who never consented to being
# in a git repository. `git add -A` in the auto-commit watcher would have
# pushed both to GitHub the first time a stranger was detected.
memory/visitor_clusters.json
memory/visitor_log.jsonl
memory/visitor_snapshots/

# Full conversation transcripts — synced between machines over the VPS memory
# API, not via git.
memory/conversations.jsonl

# Auto-commit helper
scripts/__pycache__/

# Trailing * is deliberate: a timestamped backup (config/api_keys.json.bak-…)
# was NOT matched by the bare filename and got swept into a commit by the
# auto-commit watcher's `git add -A`, putting live API keys into git history.
config/api_keys.json*
config/authorized_profiles.json*
config/override_secret.json*
config/override_audit.log
config/biometric_models/
bin/jarvis_python
bin/python_app_backup/

# Local voice clone — generated audio + trained voice model, not source
voice_clone/dataset/
voice_clone/rvc_models/*.pth
voice_clone/rvc_models/*.index

# iOS app — JarvisApp.xcodeproj is generated from project.yml via `xcodegen generate`,
# not hand-edited, so it's regenerable rather than source (also keeps machine-specific
# scheme/user-state cruft out of the auto-commit watcher's sweep).
ios/JarvisApp/JarvisApp.xcodeproj/
ios/**/DerivedData/
ios/**/*.xcuserstate
