.DS_Store
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
.venv-*/
.pytest_cache/
.mypy_cache/
.coverage
*.log

# Auto-commit helper
scripts/__pycache__/

config/api_keys.json
config/authorized_profiles.json
config/override_secret.json
config/override_audit.log
config/biometric_models/
bin/jarvis_python
bin/python_app_backup/

# Local voice clone — generated audio + trained voice model, not source
voice_clone/dataset/
voice_clone/rvc_models/*.pth
voice_clone/rvc_models/*.index

# iOS app — JarvisApp.xcodeproj is generated from project.yml via `xcodegen generate`,
# not hand-edited, so it's regenerable rather than source (also keeps machine-specific
# scheme/user-state cruft out of the auto-commit watcher's sweep).
ios/JarvisApp/JarvisApp.xcodeproj/
ios/**/DerivedData/
ios/**/*.xcuserstate
