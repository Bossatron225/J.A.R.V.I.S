# Copy to vision/.env to override defaults. All values here configure the
# SIMULATION only — this demo never calls a real background-check, people-
# search, or public-records API. See vision/README.md.

CAMERA_INDEX=0
YOLO_MODEL=yolov8n.pt
KNOWN_FACES_DIR=known_faces
FACE_MATCH_TOLERANCE=0.6
DETECTION_CONFIDENCE=0.5
FACE_RECOGNITION_EVERY_N_FRAMES=10
VERIFICATION_WORKERS=4
# Simulated network latency range for the mock verification request, seconds.
SIM_LATENCY_MIN=0.8
SIM_LATENCY_MAX=2.2
# Fraction of simulated requests that randomly "fail" (timeout), to exercise
# the error-handling path. 0.0 disables.
SIM_FAILURE_RATE=0.05
ACCESS_LOG_PATH=access_log_demo.jsonl
